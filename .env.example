# Local development defaults to SQLite. The app reads process environment,
# not this file automatically. Render environment values are set in its dashboard.
RESTRICTAPP_ENV=development
RESTRICTAPP_SECURE_COOKIES=0
# DATABASE_URL=postgresql://ROLE:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# RESTRICTAPP_RATE_SECRET=set-a-random-secret-of-at-least-32-characters
# RESTRICTAPP_ALLOWED_HOSTS=your-service.onrender.com,your-custom-domain.example
